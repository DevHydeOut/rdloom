# Read by Cloudflare Pages and Netlify. Other hosts need the same rules in their own format.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Built files have a hash in their name, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The component registry is fetched by the rdloom CLI and by other tools.
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Test and full-screen example pages stay out of search results.
/preview/*
  X-Robots-Tag: noindex
/visual/*
  X-Robots-Tag: noindex
