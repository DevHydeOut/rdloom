{
  "color": {
    "$type": "color",
    "action": {
      "primary":       { "$value": "{color.ember.700}" },
      "primary-hover": { "$value": "{color.ember.800}" },
      "on-primary":    { "$value": "{color.neutral.0}" },
      "danger":        { "$value": "{color.red.600}" },
      "danger-hover":  { "$value": "{color.red.700}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle":  { "$value": "{color.neutral.100}" },
      "raised":  { "$value": "{color.neutral.0}" },
      "selected": { "$value": "{color.ember.50}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong":  { "$value": "{color.neutral.500}" }
    },
    "feedback": {
      "danger": { "$value": "{color.red.600}" },
      "success": { "$value": "{color.green.600}" },
      "warning": { "$value": "{color.amber.700}" },
      "info": { "$value": "{color.blue.600}" },
      "danger-subtle": { "$value": "{color.red.50}" },
      "success-subtle": { "$value": "{color.green.50}" },
      "warning-subtle": { "$value": "{color.amber.50}" },
      "info-subtle": { "$value": "{color.blue.50}" }
    },
    "overlay": {
      "backdrop": { "$value": "rgb(14 14 18 / 0.5)" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted":   { "$value": "{color.neutral.600}" }
    },
    "focus": {
      "ring": { "$value": "{color.ember.600}" }
    },
    "chart": {
      "1": { "$value": "#c2410c" },
      "2": { "$value": "#2563eb" },
      "3": { "$value": "#15803d" },
      "4": { "$value": "#7c3aed" },
      "5": { "$value": "#0e7490" },
      "6": { "$value": "#be185d" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.md}" },
    "overlay": { "$value": "{radius.lg}" },
    "media": { "$value": "{radius.xl}" }
  },
  "space": {
    "$type": "dimension",
    "control-x": { "$value": "{space.4}" },
    "control-x-sm": { "$value": "{space.3}" },
    "control-x-lg": { "$value": "{space.5}" }
  },
  "elevation": {
    "$type": "shadow",
    "control": { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.16), 0 1px 2px rgb(28 26 23 / 0.22)" },
    "raised": { "$value": "0 1px 2px rgb(28 26 23 / 0.06), 0 1px 1px rgb(28 26 23 / 0.04)" },
    "floating": { "$value": "0 8px 24px -6px rgb(28 26 23 / 0.18), 0 0 0 1px rgb(28 26 23 / 0.04)" },
    "overlay": { "$value": "0 24px 64px -16px rgb(28 26 23 / 0.35), 0 0 0 1px rgb(28 26 23 / 0.05)" }
  },
  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "32px" },
    "control-md": { "$value": "40px" },
    "control-lg": { "$value": "48px" }
  }
}
