{
  "color": {
    "$type": "color",
    "action": {
      "primary":       { "$value": "{color.ember.400}" },
      "primary-hover": { "$value": "{color.ember.300}" },
      "on-primary":    { "$value": "{color.neutral.950}" },
      "danger":        { "$value": "{color.red.400}" },
      "danger-hover":  { "$value": "{color.red.300}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.950}" },
      "subtle":  { "$value": "{color.neutral.800}" },
      "raised":  { "$value": "{color.neutral.900}" },
      "selected": { "$value": "{color.ember.950}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.800}" },
      "strong":  { "$value": "{color.neutral.500}" }
    },
    "feedback": {
      "danger": { "$value": "{color.red.400}" },
      "success": { "$value": "{color.green.400}" },
      "warning": { "$value": "{color.amber.400}" },
      "info": { "$value": "{color.blue.400}" },
      "danger-subtle": { "$value": "{color.red.950}" },
      "success-subtle": { "$value": "{color.green.950}" },
      "warning-subtle": { "$value": "{color.amber.950}" },
      "info-subtle": { "$value": "{color.blue.950}" }
    },
    "overlay": {
      "backdrop": { "$value": "rgb(0 0 0 / 0.6)" }
    },
    "text": {
      "default": { "$value": "{color.neutral.50}" },
      "muted":   { "$value": "{color.neutral.400}" }
    },
    "focus": {
      "ring": { "$value": "{color.ember.300}" }
    }
  }
}
