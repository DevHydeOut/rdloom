  "components": [
    {
      "name": "Accordion",
      "id": "accordion",
      "version": "0.1.0",
      "description": "A stack of sections whose content expands and collapses under a heading, like an FAQ. Use with AccordionItem.",
      "properties": [
        {
          "prop": "allowsMultipleExpanded",
          "name": "Multiple",
          "values": [
            "false",
            "true"
          ],
          "default": "false"
        }
      ]
    },
    {
      "name": "AgentActivity",
      "id": "agent-activity",
      "version": "0.1.0",
      "description": "A short summary of what the assistant is doing or did, such as \"Used 3 tools\", that opens into each step. It stays open while a step needs approval.",
      "properties": []
    },
    {
      "name": "Alert",
      "id": "alert",
      "version": "0.1.0",
      "description": "An inline message about the state of the page or a task: a tip, a success, a warning or an error. For brief confirmations that disappear, use Toast.",
      "properties": [
        {
          "prop": "variant",
          "name": "Variant",
          "values": [
            "info",
            "success",
            "warning",
            "danger"
          ],
          "default": "info"
        }
      ]
    },
    {
      "name": "ApprovalBox",
      "id": "approval-box",
      "version": "0.1.0",
      "description": "Asks someone to approve or decline something the assistant wants to do. It says what will happen, how risky it is and whether it can be undone, in words as well as color.",
      "properties": [
        {
          "prop": "risk",
          "name": "Risk",
          "values": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        }
      ]
    },
    {
      "name": "Avatar",
      "id": "avatar",
      "version": "0.1.0",
      "description": "A person's or account's picture, falling back to their initials when there is no image or it fails to load.",
      "properties": [
        {
          "prop": "size",
          "name": "Size",
          "values": [
            "xs",
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        {
          "prop": "shape",
          "name": "Shape",
          "values": [
            "circle",
            "square"
          ],
          "default": "circle"
        }
      ]
    },
    {
      "name": "Badge",
      "id": "badge",
      "version": "0.1.0",
      "description": "A small label that states a status or category, like Paid, Overdue or Beta. Not interactive.",
      "properties": [
        {
          "prop": "variant",
          "name": "Variant",
          "values": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "default": "neutral"
        },
        {
          "prop": "size",
          "name": "Size",
          "values": [
            "sm",
            "md"
          ],
          "default": "md"
        }
      ]
    },
    {
      "name": "BlurFade",
      "id": "blur-fade",
      "version": "0.1.0",
      "description": "Content that sharpens and slides into place when it first appears or when it scrolls into view. It is visible to start with, so it never hides content from anyone.",
      "properties": []
    },
    {
      "name": "Breadcrumbs",
      "id": "breadcrumbs",
      "version": "0.1.0",
      "description": "The path from the top of the site to the current page, as links. Use BreadcrumbItem for each step; the last one is the current page.",
      "properties": []
    },
    {
      "name": "Button",
      "id": "button",
      "version": "0.1.0",
      "description": "Triggers an action or event, such as submitting a form or opening a dialog.",
      "properties": [
        {
          "prop": "variant",
          "name": "Variant",
          "values": [
            "primary",
            "secondary",
            "ghost",
            "danger"
          ],
          "default": "primary"
        },
        {
          "prop": "size",
          "name": "Size",
          "values": [
